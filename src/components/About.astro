---
export interface Props {
    basics: any;
    ui: any;
    currentLang: string;
}

const { basics, ui, currentLang } = Astro.props;
---

<section id="about" class="py-20 bg-primary text-gray-300">
    <div class="container mx-auto px-4">
        <div class="flex flex-col md:flex-row gap-12 items-center">
            
            <div class="md:w-1/4 flex justify-center">
                <div class="relative group">
                    <div class="absolute -inset-1 bg-gradient-to-r from-accent to-highlight rounded-full blur opacity-25 group-hover:opacity-75 transition duration-1000 group-hover:duration-200"></div>
                    <img class="relative w-48 h-48 rounded-full object-cover border-2 border-slate-700 group-hover:border-accent transition-colors duration-300" src={basics.image} alt={`Profile pic of ${basics.name}`} />
                </div>
            </div>

            <div class="md:w-3/4">
                <h2 class="text-2xl font-bold text-white mb-6 border-b-2 border-accent inline-block pb-1">{ui.about.title}</h2>

                <div class="space-y-4 text-justify leading-relaxed text-lg text-gray-400">
                   <p>
                        {ui.about.hi} <span class="text-white font-bold">{basics.name}</span>.
                    </p>
                    <p>
                        {basics.summary}
                    </p>
                </div>

                <div class="mt-12 flex flex-col md:flex-row gap-8 text-gray-300">
                    <div class="md:w-1/2">
                        <h2 class="text-xl font-bold text-white mb-4">{ui.about.contact}</h2>
                        <p class="leading-relaxed">
                            <span class="text-accent font-medium">{basics.name}</span><br>
                            <span class="hover:text-white transition-colors cursor-pointer">{basics.email.replace('@', '[at]')}</span><br>
                            {basics.location.region}, {basics.location.countryCode}
                        </p>
                    </div>

                    <div class="md:w-1/2 flex items-center md:justify-end gap-4">
                        <a href="/CV.pdf" class="group relative inline-flex items-center px-8 py-3 bg-secondary overflow-hidden rounded font-bold text-white shadow-lg transition-all hover:bg-slate-800 hover:scale-105 active:scale-95 no-print" download>
                           <span class="absolute right-0 w-8 h-32 -mt-12 transition-all duration-1000 transform translate-x-12 bg-white opacity-10 rotate-12 group-hover:-translate-x-40 ease"></span>
                           <svg class="w-5 h-5 mr-2 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                           {ui.about.download}
                        </a>
                         
                         {/* Link to printable view with language param */}
                         <a href={`/${currentLang}/cv-print`} class="text-gray-400 hover:text-accent font-medium transition-colors no-print border-b border-transparent hover:border-accent">
                           {ui.about.printable}
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
