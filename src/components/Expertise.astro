---
export interface Props {
    ui: any;
}

const { ui } = Astro.props;

// Hardcoded grouping based on the user's specific skills (since the JSON is flat)
const expertise = [
    {
        title: "AI & Innovation",
        icon: "fa-brain", 
        skills: ["GenAI", "Langchain", "Dataspaces", "Python"],
        desc: "Building the next generation of intelligent applications using cutting-edge LLM frameworks and data architectures."
    },
    {
        title: "Software Engineering",
        icon: "fa-code",
        skills: ["Software Product Lines", "Java", "DevOps", "Microservices"],
        desc: "Robust, scalable engineering founded on PhD-level research in variability management and code architecture."
    },
    {
        title: "Strategy & Management",
        icon: "fa-rocket",
        skills: ["R&D", "Agile Development", "Planning & Management"],
        desc: "Leading technical teams and navigating complex R&D projects from conception to delivery."
    }
];

// Mapping simplistic translation for the titles if needed, or just use English as base. 
// Ideally this should be in the UI JSON, but for this refactor we'll stick to a clean look.
---

<section id="expertise" class="py-24 bg-secondary">
    <div class="container mx-auto px-6">
        <div class="mb-16 md:text-center max-w-3xl mx-auto">
            <h2 class="text-accent font-bold tracking-widest uppercase mb-4 text-sm">My Expertise</h2>
            <h3 class="text-3xl md:text-5xl font-bold text-white mb-6">Bridging Research & Industry.</h3>
            <p class="text-gray-400 text-lg">
                I combine academic rigor with practical engineering to deliver high-value technical solutions.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {expertise.map((area, index) => (
                <div class="group relative p-8 rounded-2xl bg-primary border border-gray-800 hover:border-accent/50 transition-all duration-300 hover:shadow-2xl hover:shadow-cyan-900/10">
                    <div class="absolute top-0 right-0 p-8 opacity-10 group-hover:opacity-20 transition-opacity">
                         <i class={`fa ${area.icon} text-6xl text-accent`}></i>
                    </div>
                    
                    <div class="relative z-10">
                        <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center mb-6 text-accent group-hover:bg-accent group-hover:text-primary transition-colors">
                            <i class={`fa ${area.icon} text-xl`}></i>
                        </div>
                        
                        <h4 class="text-xl font-bold text-white mb-4">{area.title}</h4>
                        <p class="text-gray-400 mb-8 leading-relaxed text-sm">
                            {area.desc}
                        </p>

                        <div class="md:min-h-[140px]">
                            <h5 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">Core Technologies</h5>
                            <div class="flex flex-wrap gap-2">
                                {area.skills.map(skill => (
                                    <span class="px-3 py-1 rounded text-xs font-medium bg-gray-800 text-gray-300 border border-gray-700">
                                        {skill}
                                    </span>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
