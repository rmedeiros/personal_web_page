---
export interface Props {
    projects: any[];
    ui: any;
}

const { projects, ui } = Astro.props;
---

<section id="work" class="py-24 bg-primary relative overflow-hidden">
    <!-- Background Texture -->
    <div class="absolute inset-0 bg-[url('/images/grid.svg')] opacity-5 pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16">
            <div class="max-w-2xl">
                <h2 class="text-accent font-bold tracking-widest uppercase mb-4 text-sm">{ui.portfolio.title}</h2>
                <h3 class="text-3xl md:text-5xl font-bold text-white">Selected Projects.</h3>
            </div>
            <div class="hidden md:block">
                 <a href="https://github.com/rmedeiros" target="_blank" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
                    <span>View all on GitHub</span>
                    <i class="fa fa-arrow-right"></i>
                 </a>
            </div>
        </div>

        <div class="space-y-24">
            {projects.map((project: any, index: number) => (
                <div class={`flex flex-col ${index % 2 === 1 ? 'md:flex-row-reverse' : 'md:flex-row'} gap-12 items-center group`}>
                    
                    <!-- Image Card -->
                    <div class="w-full md:w-3/5 relative">
                        <div class="absolute -inset-2 bg-gradient-to-r from-accent to-highlight rounded-2xl opacity-20 blur-lg group-hover:opacity-40 transition duration-500"></div>
                        <div class="relative rounded-xl overflow-hidden bg-secondary border border-gray-700 aspect-video flex items-center justify-center p-8 group-hover:scale-[1.02] transition-transform duration-500">
                             <img src={project.image} alt={project.name} class="max-w-full max-h-full object-contain filter drop-shadow-xl" />
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="w-full md:w-2/5 space-y-6">
                        <h4 class="text-3xl font-bold text-white group-hover:text-accent transition-colors">{project.name}</h4>
                        <p class="text-gray-400 leading-relaxed text-lg">
                            {project.description}
                        </p>
                        
                        <div class="flex flex-wrap gap-2">
                            {project.keywords.map((keyword: any) => (
                                <span class="text-sm font-mono text-accent">#{keyword}</span>
                            ))}
                        </div>

                        <div class="pt-4">
                            <a href={project.url} target="_blank" class="inline-flex items-center gap-3 px-6 py-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg text-white font-bold transition-all hover:gap-4">
                                <span>{ui.portfolio.details}</span>
                                <i class="fa fa-external-link"></i>
                            </a>
                        </div>
                    </div>

                </div>
            ))}
        </div>
        
    </div>
</section>
