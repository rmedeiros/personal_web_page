---
export interface Props {
    basics: any;
    ui: any;
    currentLang: string;
}

const { basics, ui, currentLang } = Astro.props;
---

<section id="home" class="relative min-h-screen flex items-center justify-center bg-primary text-white overflow-hidden pt-20">
    <!-- Dynamic Background Elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
        <div class="absolute top-[-10%] right-[-10%] w-[50%] h-[50%] bg-accent/10 rounded-full blur-[100px] animate-pulse"></div>
        <div class="absolute bottom-[-10%] left-[-10%] w-[40%] h-[40%] bg-highlight/10 rounded-full blur-[100px] animate-pulse animation-delay-2000"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-2/3 space-y-8 text-center md:text-left">
            <div class="inline-block px-3 py-1 mb-4 text-xs font-bold tracking-widest text-accent uppercase border border-accent/30 rounded-full bg-accent/5 backdrop-blur-sm">
                Available for Projects
            </div>
            
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight leading-tight">
                Architecting <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-highlight">Intelligent</span> <br/>
                Systems.
            </h1>
            
            <p class="text-xl md:text-2xl text-gray-400 max-w-2xl leading-relaxed font-light">
                {basics.summary}
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start pt-6">
                <a href="#work" class="px-8 py-4 bg-accent text-primary font-bold rounded-lg hover:bg-white transition-all transform hover:-translate-y-1 shadow-lg shadow-cyan-500/25">
                    View My Work
                </a>
                <a href="#contact" class="px-8 py-4 border border-gray-600 text-white font-bold rounded-lg hover:border-white hover:bg-white/5 transition-all">
                    Contact Me
                </a>
            </div>
            
            <div class="pt-8 flex items-center justify-center md:justify-start gap-6 text-2xl text-gray-500">
                {basics.profiles.map((profile: any) => (
                    <a href={profile.url} target="_blank" class={`transition-colors hover:text-white fa fa-${profile.network.toLowerCase()}`}>
                        <span class="sr-only">{profile.network}</span>
                    </a>
                ))}
            </div>
        </div>

        <div class="md:w-1/3 relative hidden md:block">
            <!-- decorative abstract shape -->
            <div class="relative w-full aspect-square">
                 <div class="absolute inset-0 bg-gradient-to-tr from-accent to-highlight opacity-20 rounded-2xl rotate-3"></div>
                 <div class="absolute inset-0 border border-white/10 rounded-2xl -rotate-3 backdrop-blur-sm bg-white/5 flex items-center justify-center p-8">
                    <div class="text-center space-y-4">
                        <div class="text-6xl font-black text-white/20">PhD</div>
                        <div class="h-px w-12 bg-accent mx-auto"></div>
                        <p class="text-sm font-mono text-accent">Computer Science</p>
                    </div>
                 </div>
            </div>
        </div>
    </div>
</section>
